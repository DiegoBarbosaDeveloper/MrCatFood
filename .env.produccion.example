# Destino de producción: Supabase / PostgreSQL administrado (M8.6).
# Copia este archivo a .env.produccion (ignorado por Git) y completa los valores reales.
# El backend usa los nombres canónicos DB_URL, DB_USER y DB_PASSWORD.

DB_URL=jdbc:postgresql://<proyecto>.pooler.supabase.com:5432/postgres
DB_USER=postgres.<proyecto>
DB_PASSWORD=<contrasena_de_produccion>

# Cuenta única de la administradora
ADMIN_EMAIL=<correo_de_la_administradora>
ADMIN_PASSWORD=<contrasena_de_la_administradora>

# Firma del token (mínimo 32 bytes aleatorios)
JWT_SECRETO=<secreto_de_produccion>
JWT_EXPIRACION_MINUTOS=120

# Número de la propietaria para los enlaces wa.me, sin '+'
WHATSAPP_NUMERO=<numero_internacional>
