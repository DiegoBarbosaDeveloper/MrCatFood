# Copia este archivo a .env y reemplaza los valores. .env nunca se versiona.
#
# Base local de desarrollo (contenedor Podman, ver docs/plan.md §10):
#   podman run -d --name postgres \
#     -e POSTGRES_USER=admin -e POSTGRES_PASSWORD=admin123 -e POSTGRES_DB=mydatabase \
#     -p 5432:5432 docker.io/library/postgres:18

# Conexión a PostgreSQL (M2.2)
DB_URL=jdbc:postgresql://127.0.0.1:5432/mydatabase
DB_USER=admin
DB_PASSWORD=admin123

# Cuenta única de la administradora (M2.6)
ADMIN_EMAIL=admin@mrcatfood.local
ADMIN_PASSWORD=cambia_esta_clave

# Firma del token (M2.4): mínimo 32 bytes aleatorios, por ejemplo `openssl rand -hex 32`
JWT_SECRETO=cambia_este_secreto
JWT_EXPIRACION_MINUTOS=120

# Número de la propietaria para los enlaces wa.me (M6.1), formato internacional sin '+'
WHATSAPP_NUMERO=573001234567
